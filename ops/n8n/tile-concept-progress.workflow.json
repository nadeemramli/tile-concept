      {
        "id": "tc-setup-notes",
        "name": "Setup before publishing",
        "type": "n8n-nodes-base.stickyNote",
        "typeVersion": 1,
        "position": [
          0,
          -310
        ],
        "parameters": {
          "content": "## Tile Concept lead operations\nGoogle Sheet \u2192 app intake and atomic routing \u2192 durable Telegram card queue.\nCallbacks require Telegram secret-header authentication and the signed internal relay. App member linking, owner checks, progress history and retry deduplication run in the app database.\nSlots without app accounts stay pending. Do not put bot tokens or webhook secrets in workflow source.\nDelivery is acknowledged one card at a time. Failed cards remain queued for retry after their lease expires. No historical reposting is performed.",
          "height": 285,
          "width": 620
        }
      },
      {
        "id": "tc-new-sheet-lead",
        "name": "New Meta lead in Google Sheet",
        "type": "n8n-nodes-base.googleSheetsTrigger",
        "typeVersion": 1,
        "position": [
          0,
          100
        ],
        "parameters": {
          "pollTimes": {
            "item": [
              {
                "mode": "everyMinute"
              }
            ]
          },
          "documentId": {
            "__rl": true,
            "value": "1fMgAXAiC3mVtDNqlUwjrKL4xjbfi2CyIQ-1EsmqClPY",
            "mode": "id"
          },
          "sheetName": {
            "__rl": true,
            "value": "0",
            "mode": "id"
          },
          "event": "rowAdded",
          "options": {},
          "authentication": "serviceAccount"
        },
        "credentials": {
          "googleApi": {
            "id": "tc-google-sheets-reader",
            "name": "Tile Concept Leads Sheet (read only)"
          }
        }
      },
      {
        "id": "tc-normalize-meta",
        "name": "Validate and normalize Meta lead",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          100
        ],
        "parameters": {
          "jsCode": "\nconst output = [];\nfor (const [inputIndex, item] of $input.all().entries()) {\n  const row = item.json;\n  const text = (key, limit = 200) => String(row[key] ?? '').trim().slice(0, limit);\n  if (Object.values(row).some(value => String(value).includes('<test lead:')) || text('email').toLowerCase() === 'test@meta.com') continue;\n  const id = text('id');\n  if (!id) throw new Error('Sheet row is missing its source lead ID');\n  const rawPhone = text('phone_number', 60).replace(/^p:/i, '').replace(/[\\s()\\-]/g, '');\n  const phone = /^\\+[1-9]\\d{7,14}$/.test(rawPhone) ? rawPhone : '';\n  const rawEmail = text('email');\n  const email = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(rawEmail) ? rawEmail : '';\n  if (!phone && !email) throw new Error('Source lead ' + id + ' has no valid phone or email; review the sheet row');\n  const platform = text('platform').toLowerCase();\n  const source = platform === 'fb' ? 'facebook' : platform === 'ig' ? 'instagram' : 'meta';\n  const notes = [1, 2, 3].map(n => {\n    const key = 'conditional_question_' + n;\n    return text(key, 1000) ? key + ': ' + text(key, 1000) : '';\n  }).filter(Boolean).join('\\n');\n  const intake = {\n    submission_id: id,\n    source,\n    source_detail: ('Google Sheet 1fMgAXAiC3mVtDNqlUwjrKL4xjbfi2CyIQ-1EsmqClPY / Sheet1; adset_id=' + text('adset_id') + '; adset_name=' + text('adset_name')).slice(0, 500),\n  };\n  const optional = { customer_type: text('conditional_question_1'), name: text('full_name'), phone, email, company: text('company_name'), message: notes,\n    interest: text('conditional_question_3', 500), form_id: text('form_id'), form_name: text('form_name'),\n    campaign_id: text('campaign_id'), campaign_name: text('campaign_name'), ad_id: text('ad_id'), ad_name: text('ad_name') };\n  for (const [key, value] of Object.entries(optional)) if (value) intake[key] = value;\n  const created = text('created_time');\n  if (created) {\n    const date = new Date(created);\n    if (Number.isNaN(date.valueOf())) throw new Error('Source lead ' + id + ' has an invalid submission time');\n    intake.occurred_at = date.toISOString();\n  }\n  output.push({ json: { intake }, pairedItem: { item: inputIndex } });\n}\nreturn output;\n"
        }
      },
