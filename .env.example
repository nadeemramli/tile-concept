# Public (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
# demo | shadow | live  (PRD §12.9) — the app never writes to external systems in demo/shadow
NEXT_PUBLIC_APP_MODE=demo

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# The shared account behind "Enter as guest". Read only by enterAsGuestAction on
# the server; never sent to the browser. Omit both and the button reports that
# guest access is not configured, which is the right behaviour for an
# environment that should not have one.
# Create them with: pnpm exec tsx scripts/provision-demo-guest.mts
# Against the local stack the seed makes this account for you:
DEMO_GUEST_EMAIL=demo.guest@tileconcept.test
DEMO_GUEST_PASSWORD=TileDemo!2026
