# Public (safe in browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_APP_URL=http://localhost:3000
# demo | shadow | live  (PRD §12.9) — the app never writes to external systems in demo/shadow
NEXT_PUBLIC_APP_MODE=demo

# Server-only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# Customer feedback and optional Google review handoff (server only)
# Paste the owner-verified "Ask for reviews" URL from Google Business Profile.
TC_GOOGLE_REVIEW_URL=https://g.page/r/replace-with-your-review-link/review
# Optional: AI Gateway rewrites only the customer's supplied words. If omitted,
# the app uses its deterministic, non-AI draft builder.
AI_GATEWAY_API_KEY=
TC_REVIEW_MODEL=openai/gpt-5.4-mini

# "Enter as guest" needs no configuration. The server finds the demo account by
# its guest membership and mints a one-time token with SUPABASE_SECRET_KEY, so
# there is no guest password to store or keep in step across environments.

# Inbound lead connectors (server only)
# Shared with the n8n workflow running on the Tile Concept Hetzner server.
# n8n signs: <unix timestamp>.<raw JSON body> with HMAC-SHA256 and sends
# x-tc-timestamp + x-tc-signature headers to /api/intake/automation.
N8N_INTAKE_SECRET=replace-with-a-long-random-secret
TC_INTAKE_WORKSPACE_ID=

# Direct website-to-app intake uses the same signature envelope at
# /api/intake/website, with a distinct secret so it can be rotated separately.
INTAKE_WEBSITE_SECRET=replace-with-a-different-long-random-secret
